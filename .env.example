# Vorlage für die Umgebungsvariablen.
# Auf dem Server als .env ablegen (oder im Hosting-Panel setzen) und Werte eintragen.
# Alle Variablen sind optional — ohne sie läuft die Site mit Fallbacks (siehe Kommentare).

# ── Zugänge ──────────────────────────────────────────────────────────────
# Initial-Passwort für /admin/login. Wird nur beim ALLERERSTEN Start übernommen
# (wenn die DB neu angelegt wird); danach zählt das in /admin/einstellungen
# gesetzte Passwort. Ohne Variable: Fallback "toros2026" — unbedingt ändern!
ADMIN_PASSWORD=

# Initial-Passwort für /leads/login. Fallback: ADMIN_PASSWORD bzw. "toros2026".
LEADS_PASSWORD=

# Secret zum Signieren der Login-Cookies. Ohne Variable wird beim ersten Start
# automatisch eines erzeugt und in der DB gespeichert (reicht in der Regel aus).
# Erzeugen z. B. mit: openssl rand -hex 32
SESSION_SECRET=

# ── E-Mail-Versand (Lead- & Kontakt-Benachrichtigungen) ──────────────────
# Ohne SMTP_HOST werden keine Mails verschickt — Leads landen trotzdem in der
# DB und im /leads-Panel. Empfänger der Mails wird in /admin/einstellungen
# gepflegt (Setting "lead_empfaenger").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Absenderadresse; ohne Angabe wird SMTP_USER verwendet.
SMTP_FROM=

# ── Sonstiges ────────────────────────────────────────────────────────────
# Basis-URL für sitemap.xml und robots.txt. Fallback: https://fahrschuletoros.de
SITE_URL=https://fahrschuletoros.de
